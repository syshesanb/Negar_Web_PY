# Negar Web Application Environment Configuration
# Type of database: sqlite or postgres
DB_TYPE=sqlite

# PostgreSQL settings (uncomment if using PostgreSQL)
# DB_TYPE=postgres
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=negar_db

# Or direct DATABASE_URL
# DATABASE_URL=postgresql://postgres:password@localhost:5432/negar_db

SECRET_KEY=negar-secret-key-2026-super-secure-key
